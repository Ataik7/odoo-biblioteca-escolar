<odoo>
    <data noupdate="0">

        <!-- Un usuario de la app solo ve su propia ficha de biblioteca -->
        <record id="rule_user_portal_own" model="ir.rule">
            <field name="name">Usuario de biblioteca: cada usuario de la app solo ve su ficha</field>
            <field name="model_id" ref="model_png_biblioteca_user"/>
            <field name="domain_force">[('res_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <!-- Un usuario de la app solo ve sus propios préstamos -->
        <record id="rule_loan_portal_own" model="ir.rule">
            <field name="name">Préstamos: cada usuario de la app solo ve los suyos</field>
            <field name="model_id" ref="model_png_biblioteca_loan"/>
            <field name="domain_force">[('user_id.res_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <!-- Un usuario de la app solo ve sus propias solicitudes -->
        <record id="rule_request_portal_own" model="ir.rule">
            <field name="name">Solicitudes: cada usuario de la app solo ve las suyas</field>
            <field name="model_id" ref="model_png_biblioteca_loan_request"/>
            <field name="domain_force">[('user_id.res_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

    </data>
</odoo>
