<odoo>
    <!-- Asistente para dar acceso a la app -->
    <record id="view_app_access_wizard_form" model="ir.ui.view">
        <field name="name">png.biblioteca.app.access.wizard.form</field>
        <field name="model">png_biblioteca.app.access.wizard</field>
        <field name="arch" type="xml">
            <form string="Acceso a la App">
                                <p class="text-muted">
                    Con estos datos el usuario podrá iniciar sesión en la app de la biblioteca.
                </p>
                <group>
                    <field name="library_user_id"/>
                    <field name="login"/>
                    <field name="password" password="True"
                           placeholder="Vacía: se genera una (o se mantiene la anterior al reactivar)"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Guardar acceso" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
